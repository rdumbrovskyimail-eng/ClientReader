<?xml version="1.0" encoding="utf-8"?>
<!-- >>> FILE: app/src/main/res/values/themes.xml -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Тема окна (дневная): тёплая «каменная бумага» вместо белого, тёмные системные значки.
         Цвета совпадают с первым кадром интерфейса — при запуске ничего не мигает. -->
    <style name="Theme.ClientApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:windowBackground">@color/calm_canvas</item>
        <item name="android:colorBackground">@color/calm_canvas</item>
        <item name="android:colorAccent">@color/calm_accent</item>
        <item name="android:textColorPrimary">@color/calm_ink</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>

        <!-- Заставка Android 12+: тот же холст и «полутоновый голос» на мягкой подложке -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/calm_canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="s">@color/calm_icon_plate</item>
    </style>

</resources>